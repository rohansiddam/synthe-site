---
/* The shared site footer. The b2-card (checked by check_site.py) is identical on every
   warm page; a page may replace the default call-to-action with its own `cta` slot. */
---
<footer class="b2-footer">
  <div class="b2-wrap">

    
<slot name="cta"><section class="b2-cta" aria-label="Get started with Synthe">
      <h2 class="b2-cta-title ts-h2sm">Your agent can start improving tonight</h2>
      <p class="b2-cta-lede ts-body-lg">Open source under Apache-2.0. One command to set up.</p>
      <div class="b2-cta-actions">
        <a class="b2-btn b2-btn-primary ts-button" href="https://github.com/synthelabs/synthe" target="_blank" rel="noopener">Get started <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 17.9995L19 11.9995L13 5.99951M18.5 11.9995L5 11.9995"/></svg></a>
        <a class="b2-btn b2-btn-secondary ts-button" href="partner.html">Talk to us <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 17.9995L19 11.9995L13 5.99951M18.5 11.9995L5 11.9995"/></svg></a>
      </div>
      <div class="b2-cta-cmd"><code class="b2-cmd">npx synthe@latest init</code></div>
      <p class="b2-cta-note ts-small">Crimson Hacks, November 2026: three winning teams built with Synthe.</p>
    </section></slot>

    
<div class="b2-card">
      <nav class="b2-grid" aria-label="Footer">
        <div class="b2-col">
          <h3 class="ts-foothead">Product</h3>
          <ul class="b2-list">
            <li><a class="b2-link ts-footlink" href="how.html">How it works</a></li>
            <li><a class="b2-link ts-footlink" href="docs.html">Docs</a></li>
          </ul>
        </div>
        <div class="b2-col">
          <h3 class="ts-foothead">Resources</h3>
          <ul class="b2-list">
            <li><a class="b2-link ts-footlink" href="https://github.com/synthelabs/synthe" target="_blank" rel="noopener">GitHub</a></li>
            <li><a class="b2-link ts-footlink" href="https://www.npmjs.com/package/synthe">npm</a></li>
          </ul>
        </div>
        <div class="b2-col">
          <h3 class="ts-foothead">Company</h3>
          <ul class="b2-list">
            <li><a class="b2-link ts-footlink" href="partner.html">Talk to us</a></li>
          </ul>
        </div>
      </nav>

      <div class="b2-credit">
        <span class="b2-brand"><svg class="synthe-mark" viewBox="0 0 275 290" aria-hidden="true"><path fill="#171410" d="M 137.089 36.089 L 121.248 56.837 65.850 129.267 74.001 201.107 C 75.025 210.118 69.339 218.084 60.498 219.675 51.929 221.178 43.437 215.697 41.616 206.835 L 32.573 126.506 C 32.187 123.074 32.649 118.958 34.819 116.127 L 84.936 50.749 115.553 10.674 C 118.873 6.328 123.405 3.381 129.084 3.381 L 199.032 3.381 C 205.962 3.382 211.797 8.026 213.985 14.448 215.933 20.150 214.783 26.111 211.010 30.731 L 94.495 182.341 89.217 135.584 146.096 61.503 165.499 36.165 Z"/><path fill="#b5412f" d="M 137.911 253.913 L 153.752 233.165 209.151 160.735 200.999 88.895 C 199.976 79.884 205.661 71.918 214.503 70.327 223.072 68.824 231.564 74.305 233.384 83.167 L 242.427 163.496 C 242.814 166.928 242.352 171.044 240.182 173.875 L 190.065 239.253 159.448 279.328 C 156.127 283.674 151.595 286.621 145.916 286.621 L 75.968 286.621 C 69.039 286.620 63.204 281.976 61.016 275.554 59.067 269.852 60.218 263.891 63.991 259.271 L 180.506 107.661 185.784 154.418 128.905 228.499 109.501 253.837 Z"/></svg><span class="b2-brand-name">Synthe</span></span>
        <div class="b2-credit-lines">
          <div class="b2-credit-line1 ts-small">© 2026 Synthe</div>
          <div class="ts-small ts-w-semibold">Open source • Built by two founders</div>
        </div>
        <span class="b2-credit-spacer" aria-hidden="true"></span>
      </div>
    </div>

  </div>
</footer>
