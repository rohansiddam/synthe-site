tton></li><li><a class=\"synav-row\" href=\"how.html\"", "><span class=\"synav-label\">How it works</span></a></li><li><a class=\"synav-row\" href=\"docs.html\"", "><span class=\"synav-label\">Docs</span></a></li></ul><div class=\"synav-sheet-cta\"><a class=\"synav-btn synav-btn-2\" href=\"https://github.com/synthelabs/synthe\" target=\"_blank\" rel=\"noopener\">GitHub</a><a class=\"synav-btn synav-btn-1\" href=\"https://github.com/synthelabs/synthe\" target=\"_blank\" rel=\"noopener\">Get started<span class=\"synav-arrow\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><path d=\"M3 8h9.5M8.5 4l4 4-4 4\"/></svg></span></a></div></div><div class=\"synav-layer\" data-synav-layer=\"product\" inert><button type=\"button\" class=\"synav-back\" data-synav-to=\"main\"><svg class=\"synav-chev\" viewBox=\"0 0 10 10\" aria-hidden=\"true\"><path d=\"M6 2.5 3.5 5 6 7.5\"/></svg><span>Product</span></button><ul class=\"synav-rows\"><li><a class=\"synav-row synav-row-sub\" href=\"how.html\"><span class=\"synav-lt\">How it works</span><span class=\"synav-ld\">The nightly loop, step by step.</span></a></li><li><a class=\"synav-row synav-row-sub\" href=\"docs.html\"><span class=\"synav-lt\">Docs</span><span class=\"synav-ld\">Install, set the bar, read the report.</span></a></li><li><a class=\"synav-row synav-row-sub\" href=\"https://github.com/synthelabs/synthe\" target=\"_blank\" rel=\"noopener\"><span class=\"synav-lt\">GitHub<svg class=\"synav-ext\" viewBox=\"0 0 10 10\" aria-hidden=\"true\"><path d=\"M3.5 2.5h4v4M7.5 2.5l-5 5\"/></svg></span><span class=\"synav-ld\">Source and releases, in public.</span></a></li></ul><a class=\"synav-night synav-night-sheet\" href=\"index.html#loop\"><span class=\"synav-night-k\">Last night</span><span class=\"synav-chart\" role=\"img\" aria-label=\"Five changes scored 71, 75, 86, 68 and 70 against a bar of 80. Only 86 cleared it.\"><span class=\"synav-cols\"><span class=\"synav-col\" style=\"--v:71\"></span><span class=\"synav-col\" style=\"--v:75\"></span><span class=\"synav-col is-kept\" style=\"--v:86\"><i></i></span><span class=\"synav-col\" style=\"--v:68\"></span><span class=\"synav-col\" style=\"--v:70\"></span></span><span class=\"synav-barline\" style=\"--v:80\"></span></span><span class=\"synav-night-cap\">1 of 5 changes cleared the bar. It merged as a pull request.</span></a></div></div></div></header>"];
const CURRENT_AT: string[][] = [["index"], ["how"], ["docs"], ["how"], ["docs"]];
const html = CHUNKS.map((c, i) => (i ? (CURRENT_AT[i - 1].includes(current) ? ' aria-current="page"' : '') : '') + c).join('');
---
<Fragment set:html={html}/>
