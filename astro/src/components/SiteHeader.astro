/* The shared site header. check_site.py compares it byte for byte across the warm pages (only
   aria-current may differ). Astro would re-serialize markup (<path/> becomes <path></path>), and docs.html
   and partner.html are still hand-written, so during the move the header is emitted raw. Once every warm
   page is built by Astro, this can become plain markup again. */
interface Props { current: string }
const { current } = Astro.props;
const CHUNKS: string[] = ["<header class=\"synav\" data-synav><nav class=\"synav-bar\" aria-label=\"Main\"><div class=\"synav-brand\"><a class=\"synav-logo\" href=\"index.html\" aria-label=\"Synthe home\"", " data-synav-logo><svg class=\"synav-mark\" viewBox=\"0 0 275 290\" aria-hidden=\"true\"><path class=\"synav-mark-a\" fill=\"#171410\" d=\"M 137.089 36.089 L 121.248 56.837 65.850 129.267 74.001 201.107 C 75.025 210.118 69.339 218.084 60.498 219.675 51.929 221.178 43.437 215.697 41.616 206.835 L 32.573 126.506 C 32.187 123.074 32.649 118.958 34.819 116.127 L 84.936 50.749 115.553 10.674 C 118.873 6.328 123.405 3.381 129.084 3.381 L 199.032 3.381 C 205.962 3.382 211.797 8.026 213.985 14.448 215.933 20.150 214.783 26.111 211.010 30.731 L 94.495 182.341 89.217 135.584 146.096 61.503 165.499 36.165 Z\"/><path class=\"synav-mark-b\" fill=\"#b5412f\" d=\"M 137.911 253.913 L 153.752 233.165 209.151 160.735 200.999 88.895 C 199.976 79.884 205.661 71.918 214.503 70.327 223.072 68.824 231.564 74.305 233.384 83.167 L 242.427 163.496 C 242.814 166.928 242.352 171.044 240.182 173.875 L 190.065 239.253 159.448 279.328 C 156.127 283.674 151.595 286.621 145.916 286.621 L 75.968 286.621 C 69.039 286.620 63.204 281.976 61.016 275.554 59.067 269.852 60.218 263.891 63.991 259.271 L 180.506 107.661 185.784 154.418 128.905 228.499 109.501 253.837 Z\"/></svg><span class=\"synav-word\" aria-hidden=\"true\">Synthe</span></a><div class=\"synav-brandmenu\" id=\"synav-brandmenu\" role=\"menu\" aria-label=\"Synthe brand\" hidden><button type=\"button\" role=\"menuitem\" class=\"synav-bm\" data-copy=\"mark\"><span class=\"synav-bm-label\">Copy mark as SVG</span><span class=\"synav-bm-done\" aria-hidden=\"true\">Copied</span></button><button type=\"button\" role=\"menuitem\" class=\"synav-bm\" data-copy=\"wordmark\"><span class=\"synav-bm-label\">Copy wordmark as SVG</span><span class=\"synav-bm-done\" aria-hidden=\"true\">Copied</span></button><button type=\"button\" role=\"menuitem\" class=\