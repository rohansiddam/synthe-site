---
/* how.html, built by Astro (proof). Generated once by tools/astro_proof/convert.py from the
   hand-written page; the layout owns the shared head, header and footer. */
import Warm from '../layouts/Warm.astro';
import PageScripts from '../components/PageScripts.astro';
import { asset } from '../lib/assets.mjs';
/* SITE_PROOF_MODE=parity keeps every tag as today; the default (processed) loads one hashed bundle. */
const parity = process.env.SITE_PROOF_MODE === 'parity';
---
<Warm current="how" title={"How it works \u00b7 Synthe"} description={"How Synthe works: the loop that improves your AI agent. You set the bar in plain language; Synthe proposes small changes, tests them against your checks, merges only clear wins, and reports every morning."} canonical="https://synthe.live/how.html">
<Fragment slot="head">
<link href={asset('assets/synthe/base.css')} rel="stylesheet"/>
<link rel="stylesheet" href={asset('assets/synthe/nav-base.css')}>

<link rel="stylesheet" href={asset('assets/synthe/page-base.css')}>
<link rel="stylesheet" href={asset('assets/synthe/type-system.css')}>
<link rel="stylesheet" href={asset('assets/synthe/tokens.css')}>
<link rel="stylesheet" href={asset('assets/synthe/fixes.css')}>
<link rel="stylesheet" href={asset('assets/synthe/nav2.css')}>
<link rel="stylesheet" href={asset('assets/synthe/bottom2.css')}>
<link rel="stylesheet" href={asset('assets/synthe/how-flow.css')}>
{parity && <script is:inline src="assets/synthe/how-flow.js" defer></script>}
<link rel="stylesheet" href={asset('assets/synthe/how.css')}>
<link rel="stylesheet" href={asset('assets/synthe/site.css')}>
<link rel="stylesheet" href={asset('assets/synthe/pages.css')}>
<link rel="stylesheet" href={asset('assets/synthe/kept.css')}>
</Fragment>


<section class="pg-hero" aria-labelledby="how-title">
  <div class="pg-wrap pg-hero_in pg-hero_grid">
    <div class="pg-hero_l">
      <h1 class="pg-hero_title" id="how-title">How Synthe works</h1>
    </div>
    <div class="pg-hero_r">
      <p class="pg-hero_lede">You set the bar. Synthe makes your agents reach it on their own.</p>
      <p class="pg-hero_sub">This page walks the loop end to end: how the bar is set, how changes are proposed and tested, what has to be true before anything merges, and what lands in your repo every morning. The loop runs on any agent, toward any goal your team can state.</p>
      <div class="pg-hero_actions">
        <a class="pg-btn pg-btn--on-red" href="#loop">See the seven steps</a>
        <a class="pg-btn pg-btn--ghost-red" href="docs.html">Read the docs</a>
      </div>
    </div>
  </div>
</section>

<section class="section_home-flow fl3 how-loop pg-sec" id="loop" aria-labelledby="loop-title">
  <div class="padding-global">
    <div class="container-regular">
      <div class="fl3-head pg-head">
        <h2 class="pg-title" id="loop-title">The same loop improves every kind of agent</h2>
        <p class="pg-copy">Follow one example returns agent through a night of rounds. Pick a step, or let it play. The same seven steps run for scheduling, claims, booking and bank support agents.</p>
      </div>

      <div class="fl3-stepper" role="tablist" aria-label="Loop steps">
        <div class="fl3-rail" aria-hidden="true"><span class="fl3-rail_fill"></span></div>
        <button type="button" class="fl3-step is-active" role="tab" id="fl3-tab-1" aria-label="Step 1: Your checks" aria-controls="fl3-panel-1" aria-selected="true" tabindex="0" data-name="Your checks">
          <span class="fl3-step_node" aria-hidden="true">1</span>
          <span class="fl3-step_text"><span class="fl3-step_num">Step 1</span><span class="fl3-step_name">Your checks</span></span>
        </button>
        <button type="button" class="fl3-step" role="tab" id="fl3-tab-2" aria-label="Step 2: Simulated messages" aria-controls="fl3-panel-2" aria-selected="false" tabindex="-1" data-name="Simulated messages">
          <span class="fl3-step_node" aria-hidden="true">2</span>
          <span class="fl3-step_text"><span class="fl3-step_num">Step 2</span><span class="fl3-step_name">Simulated messages</span></span>
        </button>
        <button type="button" class="fl3-step" role="tab" id="fl3-tab-3" aria-label="Step 3: Propose a change" aria-controls="fl3-panel-3" aria-selected="false" tabindex="-1" data-name="Propose a change">
          <span class="fl3-step_node" aria-hidden="true">3</span>
          <span class="fl3-step_text"><span class="fl3-step_num">Step 3</span><span class="fl3-step_name">Propose a change</span></span>
        </button>
        <button type="button" class="fl3-step" role="tab" id="fl3-tab-4" aria-label="Step 4: Test the change" aria-controls="fl3-panel-4" aria-selected="false" tabindex="-1" data-name="Test the change">
          <span class="fl3-step_node" aria-hidden="true">4</span>
          <span class="fl3-step_text"><span class="fl3-step_num">Step 4</span><span class="fl3-step_name">Test the change</span></span>
        </button>
        <button type="button" class="fl3-step" role="tab" id="fl3-tab-5" aria-label="Step 5: Merge clear wins" aria-controls="fl3-panel-5" aria-selected="false" tabindex="-1" data-name="Merge clear wins">
          <span class="fl3-step_node" aria-hidden="true">5</span>
          <span class="fl3-step_text"><span class="fl3-step_num">Step 5</span><span class="fl3-step_name">Merge clear wins</span></span>
        </button>
        <button type="button" class="fl3-step" role="tab" id="fl3-tab-6" aria-label="Step 6: Revert losers" aria-controls="fl3-panel-6" aria-selected="false" tabindex="-1" data-name="Revert losers">
          <span class="fl3-step_node" aria-hidden="true">6</span>
          <span class="fl3-step_text"><span class="fl3-step_num">Step 6</span><span class="fl3-step_name">Revert losers</span></span>
        </button>
        <button type="button" class="fl3-step" role="tab" id="fl3-tab-7" aria-label="Step 7: The morning report" aria-controls="fl3-panel-7" aria-selected="false" tabindex="-1" data-name="The morning report">
          <span class="fl3-step_node" aria-hidden="true">7</span>
          <span class="fl3-step_text"><span class="fl3-step_num">Step 7</span><span class="fl3-step_name">The morning report</span></span>
        </button>
      </div>
      <p class="fl3-status" aria-live="polite">Step 1 of 7 · Your checks</p>
      <div class="how-night" data-how-night role="group" aria-labelledby="how-night-h">
        <p class="how-night_h" id="how-night-h">Last night</p>
        <div class="how-night_row">
          <div class="how-night_cell">
            <p class="how-night_v"><b class="how-night_n" data-to="5">5</b></p>
            <p class="how-night_l">Changes tried</p>
          </div>
          <div class="how-night_cell is-kept">
            <p class="how-night_v"><span class="how-night_k"><b class="how-night_n" data-to="1">1</b><span class="how-night_tag">PR #214</span><span class="how-night_mark" aria-hidden="true"></span></span></p>
            <p class="how-night_l">Kept</p>
          </div>
          <div class="how-night_cell">
            <p class="how-night_v"><b class="how-night_n" data-to="1">1</b><span class="how-night_note">checks 88% to 70%</span></p>
            <p class="how-night_l">Reverted</p>
          </div>
          <div class="how-night_cell">
            <p class="how-night_v"><b class="how-night_n" data-to="0.83" data-prefix="$" data-places="2">$0.83</b></p>
            <p class="how-night_l">Run cost</p>
          </div>
        </div>
      </div>

      <div class="pg-frame how-loop_frame">
      <div class="fl3-stage" data-dir="fwd">

        <article class="fl3-panel is-active" role="tabpanel" id="fl3-panel-1" aria-labelledby="fl3-tab-1" tabindex="0" data-scene="checks">
          <div class="fl3-panel_head">
            <div>
              <h3 class="fl3-panel_title">Your checks</h3>
              <p class="fl3-panel_lead">You say what good looks like, in plain language.</p>
            </div>
            <div class="fl3-panel_meta">
              <span class="fl3-chip">E-commerce · Returns agent</span>
            </div>
          </div>
          <div class="fl3-window">
            <div class="fl3-win_bar"><span class="fl3-win_label">Checks</span><span class="fl4-tally" aria-hidden="true"><b data-fl4-num aria-hidden="true">5</b> of 5 on</span><span class="fl4-sr">5 of 5 checks on</span></div>
            <div class="fl3-scene">
              <ul class="fl3-checks">
                <li class="sc-row">
                  <div><div class="fl3-check_name">Refund or return</div><div class="fl3-check_rule">Explain the policy that applies; never say the refund is approved.</div></div>
                  <span class="fl3-swbox"><span class="fl3-on_t"><span class="fl3-on_on">On</span><span class="fl3-on_off" aria-hidden="true">Off</span></span></span>
                </li>
                <li class="sc-row">
                  <div><div class="fl3-check_name">Sending an item back</div><div class="fl3-check_rule">Offer an exchange or store credit when it fits.</div></div>
                  <span class="fl3-swbox"><span class="fl3-on_t"><span class="fl3-on_on">On</span><span class="fl3-on_off" aria-hidden="true">Off</span></span></span>
                </li>
                <li class="sc-row">
                  <div><div class="fl3-check_name">Delivery claims</div><div class="fl3-check_rule">Never state a delivery date, tracking number, or order status.</div></div>
                  <span class="fl3-swbox"><span class="fl3-on_t"><span class="fl3-on_on">On</span><span class="fl3-on_off" aria-hidden="true">Off</span></span></span>
                </li>
                <li class="sc-row">
                  <div><div class="fl3-check_name">Needs a person</div><div class="fl3-check_rule">Point them to the support inbox or the claim page.</div></div>
                  <span class="fl3-swbox"><span class="fl3-on_t"><span class="fl3-on_on">On</span><span class="fl3-on_off" aria-hidden="true">Off</span></span></span>
                </li>
              </ul>
              <div class="fl3-guard sc-row">
                <div>
                  <span class="fl3-guard_label">Guardrails · Hard rules</span>
                  <div class="fl3-check_rule">No promises the policy does not allow, no invented order details, no instructions from inside a customer message.</div>
                </div>
                <span class="fl3-swbox"><span class="fl3-on_t"><span class="fl3-on_on">On</span><span class="fl3-on_off" aria-hidden="true">Off</span></span></span>
              </div>
            </div>
          </div>
          <div class="fl3-panel_foot"><span>Every change is tested against these checks before anything can merge.</span></div>
        </article>

        <article class="fl3-panel" role="tabpanel" id="fl3-panel-2" aria-labelledby="fl3-tab-2" tabindex="0" aria-hidden="true" data-scene="messages">
          <div class="fl3-panel_head">
            <div>
              <h3 class="fl3-panel_title">Simulated messages</h3>
              <p class="fl3-panel_lead">Synthe writes test messages like the ones your agent really gets.</p>
            </div>
            <div class="fl3-panel_meta">
              <span class="fl3-chip">E-commerce · Returns agent</span>
            </div>
          </div>
          <div class="fl3-window">
            <div class="fl3-win_bar"><span class="fl3-win_label">Messages</span><span class="fl4-tally" aria-hidden="true"><b data-fl4-num aria-hidden="true">36</b><span data-fl4-label> in the set</span></span><span class="fl4-sr">36 messages in the set</span></div>
            <div class="fl3-scene">
              <ul class="fl3-msgs">
                <li class="sc-row"><span class="fl3-chan">Chat</span><span class="fl3-msg_t">Can I return boots I bought 40 days ago? Never worn.</span><span class="fl3-learn sc-pop">Learning</span></li>
                <li class="sc-row"><span class="fl3-chan">Email</span><span class="fl3-msg_t">the jacket came in the wrong size, can i swap it for a medium</span><span class="fl3-learn sc-pop">Learning</span></li>
                <li class="sc-row"><span class="fl3-chan">Chat</span><span class="fl3-msg_t">It says delivered but the box never came. Can you just refund me?</span><span class="fl3-held sc-pop">Held out</span></li>
                <li class="sc-row"><span class="fl3-chan">Email</span><span class="fl3-msg_t">I lost the receipt but the tags are still on. Can I still send it back?</span><span class="fl3-learn sc-pop">Learning</span></li>
                <li class="sc-row"><span class="fl3-chan">SMS</span><span class="fl3-msg_t">where do i print the return label</span><span class="fl3-held sc-pop">Held out</span></li>
              </ul>
              <div class="fl3-morecard sc-row"><span class="fl3-more_n">+ 31 more in the set</span><span class="fl3-more_s">24 learning · 12 held out</span></div>
            </div>
          </div>
          <div class="fl3-panel_foot"><span>The writer works from the learning set. Held-out messages stay hidden until scoring.</span></div>
        </article>

        <article class="fl3-panel" role="tabpanel" id="fl3-panel-3" aria-labelledby="fl3-tab-3" tabindex="0" aria-hidden="true" data-scene="diff">
          <div class="fl3-panel_head">
            <div>
              <h3 class="fl3-panel_title">Propose a change</h3>
              <p class="fl3-panel_lead">A writer reads the failures and proposes one focused fix.</p>
            </div>
            <div class="fl3-panel_meta">
              <span class="fl3-chip">E-commerce · Returns agent</span>
              <span class="fl3-round">Round 1</span>
            </div>
          </div>
          <div class="fl3-window fl3-window--bare">
            <div class="fl3-scene">
              <div class="fl3-diff">
                <div class="fl3-diff_h sc-row"><span><span class="fl3-diff_file">prompt.md</span> · answering a return question</span><span class="fl3-diff_stat" aria-hidden="true"><b class="fl3-plus">+<b class="fl4-num" data-fl4-num aria-hidden="true">2</b></b> <b class="fl3-minus">−<b class="fl4-num" data-fl4-num aria-hidden="true">2</b></b></span><span class="fl4-sr">2 added, 2 removed</span></div>
                <div class="fl3-line is-del sc-row"><span class="fl3-sign">−</span><span>Always offer a refund when a customer asks.</span></div>
                <div class="fl3-line is-del sc-row"><span class="fl3-sign">−</span><span>Tell the customer their refund is on its way.</span></div>
                <div class="fl3-line is-add sc-row"><span class="fl3-sign">+</span><span>State the return window before any refund steps.</span></div>
                <div class="fl3-line is-add sc-row"><span class="fl3-sign">+</span><span>Say what happens next: the label, the drop-off, and when the refund is reviewed.<span class="fl3-caret" aria-hidden="true"></span></span></div>
              </div>
              <div class="how-x">
                <p class="how-x_h">What the writer read: failing replies from the learning set</p>
                <div class="how-x_row"><span class="how-x_t">“Your refund is on its way.” Sent before the item came back.</span><span class="how-x_tag is-fail">Refund or return</span></div>
                <div class="how-x_row"><span class="how-x_t">“I’ve approved a refund for the boots.” Sent at day 40.</span><span class="how-x_tag is-fail">Refund or return</span></div>
                <div class="how-x_row how-x_row--wide"><span class="how-x_t">Refund steps came first. The return window was never given.</span><span class="how-x_tag is-fail">Sending an item back</span></div>
                <div class="how-x_row how-x_row--wide"><span class="how-x_t">“Store credit only.” No exchange offered for the wrong size.</span><span class="how-x_tag is-fail">Sending an item back</span></div>
              </div>
            </div>
          </div>
          <div class="fl3-panel_foot"><span>One small change to the prompt · 1 file changed · tested before it can merge.</span></div>
        </article>

        <article class="fl3-panel" role="tabpanel" id="fl3-panel-4" aria-labelledby="fl3-tab-4" tabindex="0" aria-hidden="true" data-scene="test">
          <div class="fl3-panel_head">
            <div>
              <h3 class="fl3-panel_title">Test the change</h3>
              <p class="fl3-panel_lead">The change is tested against your checks, on learned and held-out messages.</p>
            </div>
            <div class="fl3-panel_meta">
              <span class="fl3-chip">E-commerce · Returns agent</span>
              <span class="fl3-round">Round 1</span>
            </div>
          </div>
          <div class="fl3-window">
            <div class="fl3-win_bar"><span class="fl3-win_label">Test run</span><span class="fl4-tally" aria-hidden="true">Cases run · <b data-fl4-num aria-hidden="true">36</b> / 36</span><span class="fl4-sr">36 of 36 cases run</span></div>
            <div class="fl3-scene">
              <div class="fl3-test">
                <div>
                  <div class="fl3-score sc-bar" style="--w-old:74%;--w-new:86%">
                    <div class="fl3-score_h"><span class="fl3-score_label">Checks passed</span><span class="fl3-score_n">74% → <b data-count-from="74" data-count-to="86">86%</b></span></div>
                    <div class="fl3-bar"><span class="fl3-bar_i is-old"></span></div>
                    <div class="fl3-bar"><span class="fl3-bar_i is-new"></span></div>
                    <div class="fl3-score_f"><span>Before</span><span>With the change</span></div>
                  </div>
                  <div class="fl3-score sc-bar" style="--w-old:58%;--w-new:79%">
                    <div class="fl3-score_h"><span class="fl3-score_label">Held-out score</span><span class="fl3-score_n">58% → <b data-count-from="58" data-count-to="79">79%</b></span></div>
                    <div class="fl3-bar"><span class="fl3-bar_i is-old"></span></div>
                    <div class="fl3-bar"><span class="fl3-bar_i is-new"></span></div>
                    <div class="fl3-score_f"><span>Before</span><span>With the change</span></div>
                  </div>
                </div>
                <div>
                  <div class="fl3-out_h">Per-check results</div>
                  <div class="fl3-out sc-row"><span>Refund or return</span><span class="fl3-pass sc-pop"><svg class="fl3-ic" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6.4 4.9 9.2 10 2.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Pass</span></div>
                  <div class="fl3-out sc-row"><span>Sending an item back</span><span class="fl3-pass sc-pop"><svg class="fl3-ic" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6.4 4.9 9.2 10 2.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Pass</span></div>
                  <div class="fl3-out sc-row"><span>Delivery claims</span><span class="fl3-pass sc-pop"><svg class="fl3-ic" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6.4 4.9 9.2 10 2.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Pass</span></div>
                  <div class="fl3-out sc-row is-failrow"><span>Needs a person</span><span class="fl3-fail sc-pop">Still failing</span></div>
                </div>
              </div>
              <div class="fl3-stats">
                <div class="fl3-statcard sc-row"><span class="fl3-stat_label">Head to head</span><span class="fl3-stat_value" aria-hidden="true"><b class="fl4-num" data-fl4-num aria-hidden="true">19</b> better · <b class="fl4-num" data-fl4-num aria-hidden="true">4</b> worse</span><span class="fl4-sr">19 better, 4 worse</span></div>
                <div class="fl3-statcard sc-row"><span class="fl3-stat_label">Hidden cases</span><span class="fl3-stat_value" aria-hidden="true"><b class="fl4-num" data-fl4-num aria-hidden="true">8</b> better · <b class="fl4-num" data-fl4-num aria-hidden="true">2</b> worse</span><span class="fl4-sr">8 better, 2 worse</span></div>
                <div class="fl3-statcard sc-row"><span class="fl3-stat_label">Rule breaks</span><span class="fl3-stat_value" aria-hidden="true">1 → <b class="fl4-num" data-fl4-num aria-hidden="true">0</b></span><span class="fl4-sr">Rule breaks 1 to 0</span></div>
              </div>
              <div class="how-x how-x--wide">
                <p class="how-x_h">How it was scored</p>
                <div class="how-x_row"><span class="how-x_t">Each message was answered twice, by the current prompt and by the change, then judged on your checks.</span></div>
              </div>
            </div>
          </div>
        </article>

        <article class="fl3-panel" role="tabpanel" id="fl3-panel-5" aria-labelledby="fl3-tab-5" tabindex="0" aria-hidden="true" data-scene="merge">
          <div class="fl3-panel_head">
            <div>
              <h3 class="fl3-panel_title">Merge clear wins</h3>
              <p class="fl3-panel_lead">Only a clear win merges, as a pull request in your own repo.</p>
            </div>
            <div class="fl3-panel_meta">
              <span class="fl3-chip">E-commerce · Returns agent</span>
            </div>
          </div>
          <div class="fl3-window">
            <div class="fl3-scene fl3-scene--pr">
              <div class="fl3-pr_h">
                <span class="fl3-pr_markbox"><svg class="fl3-mark fl3-mark--lock" viewBox="0 0 275 290" aria-hidden="true" focusable="false"><path class="fl3-mark_a" d="M 137.089 36.089 L 121.248 56.837 65.850 129.267 74.001 201.107 C 75.025 210.118 69.339 218.084 60.498 219.675 51.929 221.178 43.437 215.697 41.616 206.835 L 32.573 126.506 C 32.187 123.074 32.649 118.958 34.819 116.127 L 84.936 50.749 115.553 10.674 C 118.873 6.328 123.405 3.381 129.084 3.381 L 199.032 3.381 C 205.962 3.382 211.797 8.026 213.985 14.448 215.933 20.150 214.783 26.111 211.010 30.731 L 94.495 182.341 89.217 135.584 146.096 61.503 165.499 36.165 Z"/><path class="fl3-mark_b" d="M 137.911 253.913 L 153.752 233.165 209.151 160.735 200.999 88.895 C 199.976 79.884 205.661 71.918 214.503 70.327 223.072 68.824 231.564 74.305 233.384 83.167 L 242.427 163.496 C 242.814 166.928 242.352 171.044 240.182 173.875 L 190.065 239.253 159.448 279.328 C 156.127 283.674 151.595 286.621 145.916 286.621 L 75.968 286.621 C 69.039 286.620 63.204 281.976 61.016 275.554 59.067 269.852 60.218 263.891 63.991 259.271 L 180.506 107.661 185.784 154.418 128.905 228.499 109.501 253.837 Z"/></svg></span>
                <span class="fl3-merged sc-sweep">Merged</span>
                <span class="fl3-pr_no">Pull request #214</span>
              </div>
              <div class="fl3-pr_t">State the return window before the refund steps</div>
              <div class="fl3-pr_m">synthe/round-1-win → main · prompt.md · 1 file changed</div>
              <div class="fl3-gates">
                <div class="fl3-gate sc-gate"><span class="fl3-gate_n">Checks</span><span class="fl3-gate_v" aria-hidden="true">74% → <b class="fl4-num" data-fl4-num aria-hidden="true">86</b>%</span><span class="fl4-sr">Checks 74% to 86%</span><span class="fl3-gate_st"><span class="fl3-ring"><svg class="fl3-ic" viewBox="0 0 12 12" aria-hidden="true"><path class="fl3-checkpath" d="M2 6.4 4.9 9.2 10 2.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="fl3-pass_t">Passed</span></span></div>
